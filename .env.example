# cycling-workout-engine-gemini — environment variables
# Copy this file to .env (or set these as real environment variables) and
# fill in your own key. Never commit a real .env file.

# Required: your Gemini API key from https://aistudio.google.com
GEMINI_API_KEY=your-key-here
# Some SDK versions/tools look for this name instead — set either or both:
# GOOGLE_API_KEY=your-key-here

# Optional: override the model and thinking levels (see engine/llm_config.py
# and README.md "Model configuration").
#
#   Default (newest, stable):
#     WORKOUT_ENGINE_MODEL=gemini-3.8-flash
#
#   Pro tier (older, preview):
#     WORKOUT_ENGINE_MODEL=gemini-3.1-pro-preview
#
#   Thinking levels (low / medium / high):
#     WORKOUT_ENGINE_THINKING_RESEARCH=medium
#     WORKOUT_ENGINE_THINKING_STRUCTURE=high
#     WORKOUT_ENGINE_THINKING_PARSER=low
#
# Before relying on any model long-term, check the current model list and
# deprecation schedule:
#   https://ai.google.dev/gemini-api/docs/models
#   https://ai.google.dev/gemini-api/docs/deprecations
